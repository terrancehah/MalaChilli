# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Google Gemini API (for Receipt OCR) — stored server-side as Supabase secret
# NOT needed in frontend .env — the receipt-ocr edge function handles this securely.
# To configure: supabase secrets set GEMINI_API_KEY=your_key_here

